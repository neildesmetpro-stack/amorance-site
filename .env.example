# Identifiant du formulaire Formspree, partie finale de l'URL du formulaire.
# Exemple : pour https://formspree.io/f/abcdwxyz, la valeur est abcdwxyz.
NEXT_PUBLIC_FORMSPREE_ID=REMPLACER_PAR_ID_FORMSPREE

# Domaine public du site, sans barre oblique finale.
# Sert au sitemap, aux URL canoniques et aux balises hreflang.
NEXT_PUBLIC_SITE_URL=https://amorance.fr
